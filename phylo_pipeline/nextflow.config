// nextflow.config

params {
    input          = "data/cytochrome_c.fasta"
    outdir         = "results"
    bootstrap_reps = 100
}

process {
    executor = 'local'
}

// Uncomment to run everything inside a container instead of relying on
// locally installed mafft / python packages:
//
// docker.enabled = true
// process.container = 'your-registry/phylo-pipeline:latest'
